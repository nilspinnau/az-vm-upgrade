{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hash", "planHash", "vmId", "osFamily", "components", "createdAt", "expiresAt", "guestChangeConsent"],
  "properties": {
    "schemaVersion": {"const": "preparation/1.0"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vmId": {"type": "string"},
    "osFamily": {"enum": ["ubuntu", "windows"]},
    "components": {"type": "array", "minItems": 1, "items": {"enum": ["nvme-boot", "azure-vm-utils", "mana-linux-check", "mana-windows-driver"]}},
    "azureVmUtilsVersion": {"type": "string"},
    "driverPackagePath": {"type": "string"},
    "driverPackageSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "preState": {"type": "object"},
    "expectedFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expectedModelHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expectedStorageIdentityHash": {"type": ["string", "null"]},
    "createdAt": {"type": "string"},
    "expiresAt": {"type": "string"},
    "guestChangeConsent": {"const": true}
  }
}
